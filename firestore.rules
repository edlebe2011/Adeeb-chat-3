rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /meta/counter {
      allow read, write: if request.auth != null;
    }
    match /chats/{cid} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/chats/$(cid)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(db)/documents/chats/$(cid)).data.participants;
      }
    }
  }
}
